# Garden & Grace — environment (self-hosted)
# Copy to .env and fill in. Never commit the real .env.

# --- AI engine -------------------------------------------------------------
# Pick the engine. Default (unset) = anthropic + cheap Claude Haiku.
AI_PROVIDER=anthropic            # "anthropic" (safe, accurate) or "groq" (cheapest)
# AI_MODEL=                      # optional override; leave blank for the good default
#   anthropic default -> claude-haiku-4-5
#   groq default      -> meta-llama/llama-4-scout-17b-16e-instruct
#                        (verify the current vision model at console.groq.com)

ANTHROPIC_API_KEY=sk-ant-...     # needed when AI_PROVIDER=anthropic
# GROQ_API_KEY=gsk_...           # needed when AI_PROVIDER=groq

# --- the rest of the app ---------------------------------------------------
SENDGRID_API_KEY=
FROM_EMAIL=
APP_URL=http://localhost:8000
ENV=production
DB_PATH=./garden_grace_public.db
GG_COOLDOWN_SECONDS=20
GG_DAILY_LIMIT=8
